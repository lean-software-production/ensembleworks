{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "noEmit": true,
    "skipLibCheck": false
  },
  "include": [
    "server.ts",
    "app.tsx",
    "sidebar-fallback.ts",
    "request-context.ts",
    "attribution.ts",
    "hosts.ts",
    "kv.ts",
    "ownership-labels.ts",
    "people.ts",
    "presence-labels.ts",
    "components",
    "lib",
    "hooks"
  ]
}
