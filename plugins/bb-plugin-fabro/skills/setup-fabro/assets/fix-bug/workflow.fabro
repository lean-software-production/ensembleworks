digraph FixReproducedBug {
    graph [goal="Fix a reproduced bug", on_failure="exit"]
    node [timeout="30m"]
    start [shape=Mdiamond]
    exit [shape=Msquare]
    baseline [shape=parallelogram, label="Baseline", script="node __WORKFLOW_DIR__/runner.mjs baseline", goal_gate=true, on_failure="exit"]
    plan [goal_gate=true, label="Confirm reproduction", prompt="Read repository AGENTS.md instructions and .fabro-input/work-order.json. Inspect .fabro-output/reproduction-before.json and confirm the failure is the expected bug assertion, not setup or tooling failure. Stop with failed outcome if it is not. Plan a minimal fix within the agreed scope. Record the reproduction and repair strategy in .fabro-output/plan.md. Do not edit source. Do not alter .fabro-input or validation configuration to improve scores."]
    attempt [shape=parallelogram, label="Attempt budget", goal_gate=true, script="node __WORKFLOW_DIR__/runner.mjs begin-attempt", on_failure="exit"]
    implement [goal_gate=true, label="Fix bug", prompt="Read .fabro-input/work-order.json, .fabro-output/plan.md and any prior validation/review findings. Fix the reproduced bug within scope. The regression must already be committed at baseSha. Do not edit the regression test or reproduction command; leave unrelated behavior unchanged. Preserve tests and public behavior; follow repository interaction-contract obligations when applicable. Never edit .fabro-input or weaken validation/quality checks. Do not commit; the delivery stage owns committing."]
    validate [shape=parallelogram, label="Validate", script="node __WORKFLOW_DIR__/runner.mjs validate", goal_gate=true]
    review [goal_gate=true, label="Independent review", output_schema="routing", prompt="Inspect the actual diff against baseSha from .fabro-input/work-order.json and the baseline/after quality evidence in .fabro-output. Check each acceptance criterion and reproduce RED against the base and GREEN against the fix independently. Confirm the same regression is unchanged and failure matches the actual bug. Do not edit source. Write your findings to .fabro-output/review.md. Return JSON with preferred_next_label Accept only if the bug is fixed with unchanged regression and evidenced RED/GREEN, scope is respected and evidence supports the criteria. Otherwise return preferred_next_label Repair with concrete findings. Never accept merely because commands ran."]
    delivery [shape=parallelogram, label="Verify and deliver", script="node __WORKFLOW_DIR__/runner.mjs deliver", goal_gate=true, on_failure="exit"]
    start -> baseline
    baseline -> plan [condition="outcome=succeeded"]
    baseline -> exit
    plan -> attempt [condition="outcome=succeeded"]
    plan -> exit
    attempt -> implement [condition="outcome=succeeded"]
    attempt -> exit
    implement -> validate [condition="outcome=succeeded"]
    implement -> exit
    validate -> review [condition="outcome=succeeded"]
    validate -> attempt [condition="outcome=failed"]
    validate -> exit
    review -> delivery [label="Accept", condition="preferred_label=Accept"]
    review -> attempt [label="Repair", condition="preferred_label=Repair"]
    review -> exit
    delivery -> exit
  }
