digraph RalphFeatureLoop {
  graph [goal="Implement the approved feature plan", on_failure="exit"]
  node [timeout="30m"]
  start [shape="Mdiamond"]
  exit [shape="Msquare"]
  baseline [shape="parallelogram", label="Read approved plan and baseline", script="node __WORKFLOW_DIR__/runner.mjs baseline", goal_gate=true]
  plan [label="Prepare task checklist", goal_gate=true, prompt="Read AGENTS.md, .fabro-input/work-order.json and .fabro-output/approved-plan.md. This is an approved feature plan, not a request to invent a new design. Translate its full scope into .fabro-output/progress.json as {tasks:[{id,title,done:false,criteria:[0]}]}, with unique IDs and zero-based indexes covering every work-order acceptance criterion. Use 1\u201330 concrete tasks. Do not modify source or weaken the approved plan. Record execution notes in .fabro-output/plan.md. For interaction-bearing code, declare or extend the repository interaction contract; run RED before fixing and record the verbatim failure; stop if RED is unreachable; implement any Obs additions in both adapters. The independent reviewer must reproduce RED and GREEN rather than trust the implementer."]
  check_plan [shape="parallelogram", label="Validate task coverage", script="node __WORKFLOW_DIR__/runner.mjs check-plan", goal_gate=true]
  attempt [shape="parallelogram", label="Attempt budget", script="node __WORKFLOW_DIR__/runner.mjs begin-attempt", goal_gate=true]
  implement [label="Implement remaining tasks", goal_gate=true, prompt="Read .fabro-input/work-order.json, .fabro-output/approved-plan.md, progress.json, and prior validation/review findings. Implement remaining tasks in scope and repair findings. Preserve already-working behavior outside the requested feature. Update only task done flags in progress.json as work is completed; do not remove or redefine tasks. Persist useful progress notes in .fabro-output/plan.md for the next iteration. Do not edit the approved plan, .fabro/workflows, .fabro-input, or weaken validation. Do not commit, merge, push, deploy, or spawn additional work. If blocked, record the blocker and leave tasks incomplete. For interaction-bearing code, declare or extend the repository interaction contract; run RED before fixing and record the verbatim failure; stop if RED is unreachable; implement any Obs additions in both adapters. The independent reviewer must reproduce RED and GREEN rather than trust the implementer."]
  validate [shape="parallelogram", label="Run checks", script="node __WORKFLOW_DIR__/runner.mjs validate", goal_gate=true]
  review [label="Review against approved plan", goal_gate=true, output_schema="routing", prompt="Independently inspect the actual diff against baseSha, the approved-plan.md, full task checklist, and all acceptance criteria. Verify real check evidence and plan coverage; do not trust completion claims. Write .fabro-output/review.md and review.json as {verdict:accept|repair,criteria:[{index:0,passed:true,evidence:concrete evidence}]}. Use zero-based indexes for every work-order criterion. Return JSON preferred_next_label Accept only when every planned task is complete, a real scoped source change exists, tests pass, and each criterion is evidenced; otherwise return Repair with concrete remaining work. Do not change source, task definitions, the approved plan, or checks. For interaction-bearing code, declare or extend the repository interaction contract; run RED before fixing and record the verbatim failure; stop if RED is unreachable; implement any Obs additions in both adapters. The independent reviewer must reproduce RED and GREEN rather than trust the implementer."]
  delivery [shape="parallelogram", label="Verify completion and deliver", script="node __WORKFLOW_DIR__/runner.mjs deliver", goal_gate=true]
  start -> baseline
  baseline -> plan [condition="outcome=succeeded"]
  baseline -> exit
  plan -> check_plan [condition="outcome=succeeded"]
  plan -> exit
  check_plan -> attempt [condition="outcome=succeeded"]
  check_plan -> exit
  attempt -> implement [condition="outcome=succeeded"]
  attempt -> exit
  implement -> validate [condition="outcome=succeeded"]
  implement -> exit
  validate -> review [condition="outcome=succeeded"]
  validate -> attempt [condition="outcome=failed"]
  validate -> exit
  review -> delivery [label="Accept", condition="preferred_label=Accept"]
  review -> attempt [label="Repair", condition="preferred_label=Repair"]
  review -> exit
  delivery -> exit
}
