{
  "version": 1,
  "name": "Refactor code quality",
  "workflow": "workflow.fabro",
  "files": [
    "workflow.fabro",
    "runner.mjs"
  ],
  "environment": "local",
  "autoApprove": true,
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "validationCommands",
      "qualityCommand"
    ],
    "properties": {
      "setupCommands": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "maxItems": 8
      },
      "validationCommands": {
        "type": "array",
        "minItems": 1,
        "maxItems": 12,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "qualityCommand": {
        "type": "string",
        "minLength": 1
      },
      "qualityMode": {
        "type": "string",
        "enum": [
          "gate",
          "report"
        ],
        "description": "Default gate requires exit zero. Report allows findings but still rejects execution errors."
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "required": [
      "baseSha",
      "resultSha",
      "changedFiles",
      "before",
      "after",
      "review",
      "outcome"
    ],
    "properties": {
      "baseSha": {
        "type": "string",
        "pattern": "^[a-f0-9]{40}$"
      },
      "resultSha": {
        "type": "string",
        "pattern": "^[a-f0-9]{40}$"
      },
      "changedFiles": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "before": {
        "type": "object"
      },
      "after": {
        "type": "object"
      },
      "review": {
        "type": "string",
        "minLength": 1
      },
      "outcome": {
        "enum": [
          "changed",
          "no_change"
        ]
      }
    }
  },
  "acceptanceInstructions": "Independently inspect the diff against baseSha. Verify each work-order criterion, allowed scope, behavior preservation, passing validation, and improved quality. A no-change result needs an evidence-backed reason. Acceptance does not merge or publish."
}
