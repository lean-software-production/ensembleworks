{
  "version": 1,
  "name": "Ralph feature implementation loop",
  "workflow": "workflow.fabro",
  "files": [
    "workflow.fabro",
    "runner.mjs"
  ],
  "environment": "local",
  "autoApprove": true,
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "validationCommands",
      "qualityCommand",
      "planPath"
    ],
    "properties": {
      "setupCommands": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "maxItems": 8
      },
      "validationCommands": {
        "type": "array",
        "minItems": 1,
        "maxItems": 12,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "qualityCommand": {
        "type": "string",
        "minLength": 1
      },
      "qualityMode": {
        "type": "string",
        "enum": [
          "gate",
          "report"
        ],
        "description": "Default gate requires exit zero. Report allows findings but still rejects execution errors."
      },
      "planPath": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500,
        "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.md$"
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "required": [
      "baseSha",
      "resultSha",
      "changedFiles",
      "before",
      "after",
      "review",
      "outcome",
      "plan",
      "tasks",
      "criterionReview"
    ],
    "properties": {
      "baseSha": {
        "type": "string",
        "pattern": "^[a-f0-9]{40}$"
      },
      "resultSha": {
        "type": "string",
        "pattern": "^[a-f0-9]{40}$"
      },
      "changedFiles": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "before": {
        "type": "object"
      },
      "after": {
        "type": "object"
      },
      "review": {
        "type": "string",
        "minLength": 1
      },
      "outcome": {
        "const": "changed"
      },
      "plan": {
        "type": "object",
        "required": [
          "path",
          "baseSha",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "baseSha": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          }
        }
      },
      "tasks": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "id",
            "title",
            "done"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "done": {
              "const": true
            }
          }
        }
      },
      "criterionReview": {
        "type": "object"
      }
    }
  },
  "acceptanceInstructions": "Compare the actual diff and checks against the approved plan pinned at baseSha and every original acceptance criterion. Read task progress and criterion review evidence; independently verify claims. All tasks must be complete, every criterion evidenced, and required interaction-contract RED/green and independent verification preserved. Do not accept workflow success or a completion claim alone. No merge, push, or deployment. For canvas-editor tools, canvas-react, or client canvas-v2 input/tool changes, declare or extend an interaction contract (or justify ux-contract: none), record verbatim RED before fixing and stop if unreachable, implement Obs additions in both FSM and browser adapters, and independently verify RED/GREEN during review."
}
