#!/usr/bin/env bash
# git-credential-ensembleworks — git credential helper that authenticates the
# terminal sandbox user as the ensembleworks[bot] GitHub App.
#
# Installed to /usr/local/bin by deploy/deploy.sh and wired into the sandbox
# user's OWN ~/.gitconfig behind `cache --timeout=2700`. It answers ONLY the
# `get` operation, ONLY for https://github.com, and ONLY when the invoking user
# is the sandbox user — every other case declines silently (exit 0, no output),
# so git falls through to its normal behaviour and no other user on the box, and
# no developer machine without the App, is affected.
#
# Deliberately NOT repo-scoped: an org-wide token is valid for every repo the App
# is installed on, whereas a repo-scoped token cached by credential-cache gets
# replayed against a different repo and 403s. (EW25 removed the wrapper's repo
# argument outright.)
#
# The token is written to stdout in the credential protocol and NOWHERE else: no
# logging, no `set -x`, never in an error message.
set -euo pipefail

AGENT_USER="ensembleworks-agent"

# Only `get` is answered; store/erase are silent no-ops.
[ "${1:-}" = "get" ] || exit 0

host=""
proto=""
while IFS='=' read -r key value; do
	if [ -z "$key" ]; then break; fi
	case "$key" in
	host) host="$value" ;;
	protocol) proto="$value" ;;
	esac
done

[ "$proto" = "https" ] || exit 0
[ "$host" = "github.com" ] || exit 0
[ "$(id -un)" = "$AGENT_USER" ] || exit 0

# -n so a missing NOPASSWD sudoers rule fails fast instead of hanging on a
# password prompt in a non-interactive shell. Any failure -> decline.
token="$(sudo -n -u ensembleworks ensembleworks-gh-token 2>/dev/null)" || exit 0
[ -n "$token" ] || exit 0

printf 'username=x-access-token\n'
printf 'password=%s\n' "$token"
