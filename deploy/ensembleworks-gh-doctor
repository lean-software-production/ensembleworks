#!/usr/bin/env bash
# ensembleworks-gh-doctor — answers "why is GitHub auth failing?" with one
# distinct diagnosis per failure mode, instead of the generic 403 that a
# missing App install, a wrong-owner remote, and an expired token all present
# as. Installed to /usr/local/bin by deploy/deploy.sh, and also run
# non-interactively by deploy.sh itself right after install (see deploy.sh's
# "Deploy-time verification").
#
# Runs the checks below in dependency order and stops at the first hard
# failure — later checks assume earlier ones held, so running them past a
# failure would just produce confusing secondary noise. Check 8 is warn-only
# and never fails the run.
#
# The token is NEVER printed — only its length, so a human can confirm one
# exists without it leaking into a terminal transcript that the whole room can
# see. --quiet prints only failures — it suppresses the passing-check lines AND
# check 8's warnings, so the deploy-time invocation cannot spray one warn line
# per SSH clone into the deploy log.
#
# Deliberately `set -u` only, not `-e`: nearly every check captures a command's
# exit code to route between distinct diagnoses (mint failure vs. missing env,
# 404 vs. bad token, ...), which `-e` would abort past before the code could be
# inspected.
set -u

AGENT_USER="ensembleworks-agent"
# Test seams (mirroring gh-shim's EW_GH_REAL): point the "expected helper /
# expected gh" checks at a sandboxed script instead of the real installed
# path. They grant nothing beyond what the caller's own environment already
# controls.
HELPER_PATH="${EW_GH_DOCTOR_HELPER_PATH:-/usr/local/bin/git-credential-ensembleworks}"
PROC_STATUS="${EW_GH_DOCTOR_PROC_STATUS:-/proc/self/status}"

REPO_OWNER="lean-software-production"
REPO_NAME="ensembleworks"
REPO_URL="https://github.com/${REPO_OWNER}/${REPO_NAME}.git"
GH_BIN="${EW_GH_DOCTOR_GH_BIN:-/usr/local/bin/gh}"

QUIET=0
[ "${1:-}" = "--quiet" ] && QUIET=1

ok() {
	[ "$QUIET" -eq 1 ] || echo "ok  : $1"
}
fail() {
	echo "FAIL: $1" >&2
	exit 1
}

# 1. invoking user must be the sandbox agent user — every other check assumes
# this, since the sudoers rule and gitconfig below are provisioned only for it.
user="$(id -un)"
[ "$user" = "$AGENT_USER" ] || fail "auth is provisioned for \`${AGENT_USER}\`; you are \`${user}\`"
ok "invoking user is ${AGENT_USER}"

# 1b. an injected token wins. When GH_TOKEN or GITHUB_TOKEN is set (BB's
# github-app-auth plugin sets both at the start of every agent turn), gh uses
# it and the shim never mints; inside a BB thread git does too, because the
# plugin routes git's credentials through `gh auth git-credential`. That token
# lives ~1h and is only refreshed when a turn starts, so a long turn outlives
# it — and every git/gh call then fails while the mint path below is perfectly
# healthy. Check the token actually in use before the one we could mint.
injected="${GH_TOKEN:-${GITHUB_TOKEN:-}}"
# Read up front: a sandbox's network filter also explains a failed API call.
nnp="$(sed -n 's/^NoNewPrivs:[[:space:]]*//p' "$PROC_STATUS" 2>/dev/null)"
if [ -n "$injected" ]; then
	inj_out="$(GH_TOKEN="$injected" "$GH_BIN" api /rate_limit --jq .resources.core.limit 2>&1)"
	inj_rc=$?
	if [ "$inj_rc" -ne 0 ]; then
		case "$inj_out" in
		*"401"*|*"Bad credentials"*) fail "GH_TOKEN in this environment is expired or invalid — in a BB thread run \`eval \"\$(bb github-app-auth env)\"\` and retry in that same shell; elsewhere unset GH_TOKEN/GITHUB_TOKEN" ;;
		*) [ "$nnp" = "1" ] && fail "running inside an agent sandbox that blocks GitHub (${inj_out}) — re-run the git/gh command (and this doctor) outside the sandbox"
			fail "GH_TOKEN is set but an API call with it failed: ${inj_out}" ;;
		esac
	fi
	ok "GH_TOKEN in the environment is valid (gh uses it; in a BB thread git does too)"
fi

# 1c. inside an agent sandbox (Claude Code's bash sandbox, Codex) the
# no_new_privs flag is set, so sudo refuses to run at all and the mint path
# below can't work no matter how the box is provisioned. Say so, rather than
# letting check 2 misreport it as a missing sudoers rule.
if [ "$nnp" = "1" ]; then
	if [ -n "$injected" ]; then
		ok "inside an agent sandbox: the injected GH_TOKEN authenticates here; re-run outside the sandbox to check the mint path"
		[ "$QUIET" -eq 1 ] || echo "all checks passed (mint path not checked from inside the sandbox)"
		exit 0
	fi
	fail "running inside an agent sandbox, where sudo can't mint a token — re-run the git/gh command (and this doctor) outside the sandbox; don't ask for a personal token or run \`gh auth login\`"
fi

# 2. the NOPASSWD sudoers rule that lets this user mint a token as the app
# user must exist — without it, check 3's mint attempt just hangs or 403s with
# no clue why.
sudo_rules="$(sudo -n -l 2>/dev/null)" || sudo_rules=""
case "$sudo_rules" in
*ensembleworks-gh-token*) ok "NOPASSWD sudoers rule for ensembleworks-gh-token present" ;;
*) fail "NOPASSWD sudoers rule missing — host provisioning, see \`deploy/github-app-runbook.md\`" ;;
esac

# 3. the token itself mints. Distinguish "App not provisioned on this box"
# (github-app.env missing on the app user) from any other mint/API error,
# since they need different fixes.
# stderr goes to its own file rather than being merged into the capture: on the
# success path a chatty wrapper would otherwise become part of $token, making
# the reported length wrong and letting unrelated stderr text match a case
# pattern below.
mint_err="$(mktemp)"
trap 'rm -f "$mint_err"' EXIT
token="$(sudo -n -u ensembleworks ensembleworks-gh-token 2>"$mint_err")"
mint_rc=$?
if [ "$mint_rc" -ne 0 ]; then
	case "$(cat "$mint_err")" in
	*"github-app.env missing"*) fail "github-app.env missing — App not provisioned on this box" ;;
	*) fail "token mint failed: $(cat "$mint_err")" ;;
	esac
fi
[ -n "$token" ] || fail "token mint failed: ensembleworks-gh-token produced no output"
ok "token mint succeeded (length ${#token})"

# 4. ~/.gitconfig must name our minting helper for https://github.com — and
# must NOT put a `cache` helper in front of it. git re-stores the credential
# after every successful operation, restarting the cache timer, so a busy
# token stayed cached past its ~1h life and the next push failed with
# "Invalid username or token". deploy/deploy.sh no longer seeds it.
helpers="$(git config --get-all credential.https://github.com.helper 2>/dev/null || true)"
has_cache=0
has_ew=0
stale=""
while IFS= read -r h; do
	[ -z "$h" ] && continue
	case "$h" in
	cache*) has_cache=1 ;;
	"$HELPER_PATH") has_ew=1 ;;
	*) stale="${stale} ${h}" ;;
	esac
done <<HELPERS
${helpers}
HELPERS
if [ "$has_ew" -eq 0 ]; then
	msg="credential helper not configured in ~/.gitconfig — redeploy"
	[ -n "$stale" ] && msg="${msg} (found stale helper(s):${stale})"
	fail "$msg"
fi
[ "$has_cache" -eq 0 ] || fail "a \`cache\` credential helper in ~/.gitconfig can replay expired tokens — redeploy (or \`git config --global --unset-all credential.https://github.com.helper\` and re-add ${HELPER_PATH}), then \`git credential-cache exit\`"
ok "credential helper configured (${HELPER_PATH})"

# 5. the configured helper must actually hand back a password when asked —
# distinct from check 4, since "configured" and "working" fail for different
# reasons (reseed gitconfig vs. redeploy the helper binary).
fill_out="$(printf 'protocol=https\nhost=github.com\n\n' |
	GIT_TERMINAL_PROMPT=0 git credential fill 2>/dev/null)" || fill_out=""
case "$fill_out" in
*"password="*) ok "credential fill returns a token" ;;
*) fail "helper configured but returning nothing" ;;
esac

# 6. an actual git operation against the repo, over the credential machinery
# just verified in checks 4/5. A 404-shaped failure means the App isn't
# installed on that owner; anything else means the token itself is bad —
# different fixes (install the App vs. re-provision the token).
lsremote_out="$(GIT_TERMINAL_PROMPT=0 git ls-remote "$REPO_URL" HEAD 2>&1)"
lsremote_rc=$?
if [ "$lsremote_rc" -ne 0 ]; then
	case "$lsremote_out" in
	*"not found"*|*"Not Found"*|*"404"*) fail "App not installed on that owner (repository not found via ls-remote)" ;;
	*) fail "token rejected / expired (git ls-remote failed: ${lsremote_out})" ;;
	esac
fi
ok "git ls-remote against ${REPO_OWNER}/${REPO_NAME} succeeded"

# 7. gh itself must resolve to the shim (not a `gh` earlier on PATH that
# bypasses it entirely), and an actual API call through it must succeed.
gh_path="$(command -v gh 2>/dev/null || true)"
if [ "$gh_path" != "$GH_BIN" ]; then
	fail "a different gh is earlier on PATH: ${gh_path:-<not found>}"
fi
gh_out="$(gh api "/repos/${REPO_OWNER}/${REPO_NAME}" --jq .full_name 2>&1)"
gh_rc=$?
if [ "$gh_rc" -ne 0 ]; then
	fail "gh authenticated but API call failed: ${gh_out}"
fi
ok "gh (${gh_path}) authenticated and the API call succeeded (${gh_out})"

# 8. warn-only: an SSH remote under the agent's home bypasses the credential
# helper entirely (git never consults it for git@ URLs), so a clone left on
# SSH silently falls back to whatever SSH keys happen to be around. This never
# fails the run — a human decides whether/when to switch it.
if [ -n "${HOME:-}" ] && [ -d "$HOME" ]; then
	while IFS= read -r gitdir; do
		[ -n "$gitdir" ] || continue
		repo="$(dirname "$gitdir")"
		remote="$(git -C "$repo" remote get-url origin 2>/dev/null || true)"
		case "$remote" in
		git@github.com:*)
			[ "$QUIET" -eq 1 ] || echo "warn: SSH remote bypasses credential helpers entirely — switch ${repo} to HTTPS" >&2
			;;
		esac
	done <<REPOS
$(find "$HOME" -maxdepth 4 -name .git -type d 2>/dev/null)
REPOS
fi

[ "$QUIET" -eq 1 ] || echo "all checks passed"
exit 0
