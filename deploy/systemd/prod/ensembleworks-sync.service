# EnsembleWorks sync server — PRODUCTION unit (non-watch). Installed by
# deploy/deploy.sh, which substitutes @APP_USER@ / @APP_HOME@ / @SYNC_MEMORY_MAX@
# (sed). Slice membership + the protected MemoryLow AND MemoryMax live here (the
# host owns the ensembleworks.slice envelope; this is the app's sub-division).
# The sync server also serves the static client build (CLIENT_DIST) in production.
[Unit]
Description=EnsembleWorks sync server (tldraw sync + assets + API)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@APP_USER@
WorkingDirectory=@APP_HOME@/current
Slice=ensembleworks.slice
MemoryAccounting=yes
MemoryLow=512M
# Ceiling, derived per box by deploy.sh (see "derive the sync memory ceiling").
# Without one, sync alone can consume the whole slice: on 2026-09-08 a /files
# buffer leak (#79) took it to 12.1 G and pinned ensembleworks.slice at its
# MemoryHigh for ~5 hours -- 14.3k breaches/sec, memory PSI full 75%, load 42 --
# stalling term/scribe/files/discord as collateral. No OOM ever fired, so it
# degraded indefinitely instead of self-resolving. This bounds a future leak to
# one service being reclaimed rather than the whole app tenant stalling.
#
# OOMPolicy=continue is load-bearing, not decoration: systemd's default is
# OOMPolicy=stop, which turns "the kernel reaped something in this cgroup" into
# "the unit is stopped" -- i.e. the outage we are preventing, reached by another
# route. With continue, Restart=on-failure below brings sync straight back.
MemoryMax=@SYNC_MEMORY_MAX@
OOMPolicy=continue
Environment=PORT=8788
Environment=CLIENT_DIST=@APP_HOME@/current/client-dist
EnvironmentFile=@APP_HOME@/.config/ensembleworks/sync.env
# Storage geometry contract: DATA_DIR + DATABASE_DIR + DATABASE_BACKUPS_DIR
# come ONLY from storage.env — deliberately no Environment= lines for them
# here (EnvironmentFile= outranks Environment=, so a unit-level value would be
# shadow config the moment an env file disagreed). The same file is sourced by
# the laingville ensembleworks-database-backup/restore units, so the sync
# server and the backup timer cannot disagree about the paths; the server
# validates the triple at startup and REFUSES TO BOOT on missing or
# collision-shaped values (live DBs nested in the data root, backup
# destination overlapping live DBs — the 2026-07-10 ew-lsp-001 corruption
# shapes). A missing storage.env fails the unit start: that is the fail-closed
# design, not a bug. Provisioned by the laingville bootstrap; see
# docs/superpowers/specs/2026-07-11-required-database-dirs-design.md.
EnvironmentFile=@APP_HOME@/.config/ensembleworks/storage.env
ExecStart=@APP_HOME@/current/ensembleworks-server sync
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
