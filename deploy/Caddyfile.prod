# EnsembleWorks — PRODUCTION Caddy edge (deployed boxes). Plain HTTP on :8080;
# TLS is terminated upstream by the Cloudflare Tunnel. Everything except the
# media signaling (/livekit), the embedded dev-server proxy (/dev/{port}) and the
# terminal LOCAL plane (/api/terminal/{health,sessions,ws}) is proxied to the
# sync server on :8788 — which serves /sync (tldraw WS), /api (including the
# terminal RELAY plane), /uploads AND the static client build + SPA fallback.
# The sync server runs as the app user, so it reads the build from its own home;
# Caddy never touches the home dir (keeps it 700). deploy/deploy.sh installs this
# to /etc/caddy/Caddyfile.

:8080 {
	@livekit path /livekit /livekit/*
	handle @livekit {
		uri strip_prefix /livekit
		reverse_proxy localhost:7880
	}

	# The sync server now terminates /dev itself (server/src/features/
	# dev-proxy.ts) so it can inject the recorder bridge + URL patch + error
	# reporter into top-level HTML — Caddy just forwards the whole /dev/{port}
	# path through, unstripped.
	@dev path_regexp dev ^/dev/(\d+)(/.*)?$
	handle @dev {
		reverse_proxy localhost:8788
	}

	# The shared browser (neko, ensembleworks-shared-browser.service) — its own
	# named route, not /dev/{port}. neko's HTTP+WS is on loopback :8090 and serves
	# at root with relative paths, so stripping the prefix is all it needs (same
	# mechanism as /dev); reverse_proxy upgrades the control WebSocket, while the
	# WebRTC media is UDP and never passes through here. Harmless when the optional
	# service isn't running (the shape just shows a 502). The neko shape's `base`
	# points at /shared-browser/ (client/src/neko/NekoShapeUtil.tsx).
	@shared-browser path /shared-browser /shared-browser/*
	handle @shared-browser {
		uri strip_prefix /shared-browser
		reverse_proxy localhost:8090
	}

	# Terminal LOCAL plane (node-pty + tmux; WebSocket) — served by the separate
	# gateway process on :8789. The RELAY plane (/api/terminal/{status,list,
	# connect,relay}) stays on the sync server (:8788) via the handle{} below.
	@term_local path /api/terminal/health /api/terminal/sessions /api/terminal/sessions/* /api/terminal/ws
	handle @term_local {
		reverse_proxy localhost:8789
	}

	# Canvas backend traffic, named explicitly so it wins BEFORE @devref below —
	# without this, any request from a dev-Referer page for one of these paths
	# (e.g. /files-assets/rrweb.js loaded from a /dev/{port} page) would fall
	# into @devref and get hijacked to the dev server instead, 404ing (recorder
	# stays permanently dormant). /sync, /api, /uploads, /files, /files-assets
	# all live on the sync server; static client assets (/assets/x.js) are
	# handled by the catch-all below and are NOT enumerable here, but that's
	# safe: they're only ever requested by the canvas app itself, which is
	# never loaded from a /dev page, so they never carry a dev Referer for
	# @devref to catch in the first place.
	@backend path /sync /sync/* /api /api/* /uploads /uploads/* /files /files/* /files-assets /files-assets/*
	handle @backend {
		reverse_proxy localhost:8788
	}

	# Referer fallback (spec: web-viewer unification §2): a dev app's root-
	# absolute asset request (/assets/x.js) misses every canvas route; if the
	# page it came from is under /dev/{port}/, send it to that dev server via
	# the injecting proxy. Canvas-owned prefixes never reach here — every
	# earlier handle wins first, and Caddy handle blocks are mutually
	# exclusive in file order.
	@devref header_regexp ref Referer /dev/(\d+)/
	handle @devref {
		rewrite * /dev/{re.ref.1}{uri}
		reverse_proxy localhost:8788
	}

	# Everything else — the app + static client/SPA — is served by the sync
	# server (which serves client/dist in production).
	handle {
		reverse_proxy localhost:8788
	}
}
